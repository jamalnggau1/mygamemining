# Salin file ini menjadi .env.local untuk pengembangan lokal.
# JANGAN PERNAH mengisi nilai asli ke file yang ikut ter-commit —
# string koneksi Neon hanya boleh hidup di environment variable
# (Vercel Project Settings → Environment Variables, atau .env.local
# yang sudah di-gitignore).
DATABASE_URL=
# Token bot Telegram dari BotFather — dipakai server untuk memvalidasi
# initData pemain. TANPA INI pemain Telegram ditolak semua (fail
# closed). Jangan pernah menempel token asli di chat/file/log.
BOT_TOKEN=
# Id numerik Telegram pemilik game (lihat via @userinfobot) — hanya
# id ini yang boleh memakai Kendali (WD, konfirmasi Premium).
ADMIN_TELEGRAM_ID=
